{
  "files.associations": {
    "**/pipelines/**/*.yml": "azure-pipelines",
    "**/.github/**/*.yml": "github-actions-workflow"
  },
  "reduxdev.port": 8000,
  "reduxdev.hostname": "localhost",
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "editor.codeActionsOnSave": {
    "source.addMissingImports": "explicit",
    "source.addMissingImports.ts": "explicit",
    "source.fixAll.eslint": "always",
    "source.fixAll.oxc": "always"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "react-ai-helper.aiBaseURL": "http://localhost:1337/v1",
  "react-ai-helper.aiModel": "codestral-22b",
  "react-ai-helper.testIDPrefixFileNameRegex": "src/modules/([^/]+)/",
  "cSpell.words": [
    "bottomsheet",
    "EVSE",
    "evses",
    "Linkings",
    "recyclepunten",
    "Sourceid"
  ],
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "chat.tools.terminal.autoApprove": {
    "npx jest": true,
    "npx tsc": true,
    "npx eslint": true,
    "npx oxlint": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${basename}.*.ts",
    "*.mts": "${capture}.js, ${basename}.*.mts, ${basename}.*.ts",
    "*.tsx": "${capture}.ts, ${capture}.*.tsx, ${capture}.*.mdx, ${basename}.*.tsx, ${basename}.*.ts, ${basename}.*.mdx",
    "*.context.tsx": "${capture}.provider.tsx, ${capture}.provider.ts",
    "*.context.ts": "${capture}.provider.tsx, ${capture}.provider.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock"
  },
  "explorer.fileNesting.expand": false
}
